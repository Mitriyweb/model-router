# Port to run model-router on
PORT=8787

# Tier order preference: cerebras,groq,gemini,openrouter,mistral,nvidia,cloudflare,cohere,local
FALLBACK_ORDER=cerebras,groq,gemini,openrouter,mistral,nvidia,cloudflare,cohere,local

# Cerebras (Ultra-fast Llama inference, 1M+ tokens/day: https://cloud.cerebras.ai)
CEREBRAS_API_KEY=csk_...
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_RPM=30
CEREBRAS_TPM=60000
CEREBRAS_RPD=14400

# Groq (Free fast inference: https://console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RPM=30
GROQ_TPM=6000
GROQ_RPD=14400

# Google Gemini (Free tier, 1M TPM context: https://aistudio.google.com)
# Prefer a current stable model; older Gemini 2.0 IDs can be blocked for new accounts.
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash
GEMINI_RPM=15
GEMINI_TPM=1000000
GEMINI_RPD=1500

# OpenRouter (Free models: https://openrouter.ai/openrouter/free)
# Use the OpenRouter free-router alias; it automatically selects a currently available free model.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openrouter/free
OPENROUTER_RPM=20
OPENROUTER_TPM=40000
OPENROUTER_RPD=50

# Debug toggle: disable exact-repeat cache to see raw upstream routing
# ROUTER_DISABLE_CACHE=true

# Mistral AI (Free tier ~1B tokens/month, 2 RPM: https://console.mistral.ai)
MISTRAL_API_KEY=...
MISTRAL_MODEL=codestral-latest
MISTRAL_RPM=2
MISTRAL_TPM=500000
MISTRAL_RPD=1000

# NVIDIA NIM (90+ free models: https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_RPM=40
NVIDIA_TPM=40000
NVIDIA_RPD=1000

# Cloudflare Workers AI (20+ free models: https://dash.cloudflare.com)
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_RPM=60
CLOUDFLARE_TPM=50000
CLOUDFLARE_RPD=10000

# Cohere (Command R+ tool-use API: https://dashboard.cohere.com)
COHERE_API_KEY=...
COHERE_MODEL=command-r-plus-08-2024
COHERE_RPM=10
COHERE_TPM=20000
COHERE_RPD=100

# Local OpenAI-compatible server (Ollama, llama.cpp, etc.)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5-coder:7b
LOCAL_RPM=120
LOCAL_TPM=100000
LOCAL_RPD=100000

# State persistence path
RATE_LIMIT_STATE_FILE=.router-state.json
