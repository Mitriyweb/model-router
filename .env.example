# Generated by scripts/generate-env-example.ts — do not edit by hand.
# Run `bun run env:generate` after changing src/providers/definitions.ts.

# Server
ROUTER_HOST=127.0.0.1
PORT=8787
# Log verbosity: debug | info | warn | error | silent (default: info).
LOG_LEVEL=info
# Optional Bearer token required by /reset, /reset-state and /v1/reset.
ROUTER_AUTH_TOKEN=
# Disable the exact-repeat cache (true/false).
ROUTER_DISABLE_CACHE=false
ROUTER_CACHE_TTL_MS=600000
ROUTER_CACHE_MAX_ENTRIES=500
ROUTER_MAX_BODY_BYTES=1048576
# Empty disables CORS; use * or an http(s) origin.
ROUTER_CORS_ORIGIN=
ROUTER_MAX_CONTEXT_TOKENS=128000
RATE_LIMIT_STATE_FILE=.router-state.json

# Tier order preference: cerebras,groq,gemini,openrouter,mistral,nvidia,huggingface,cloudflare,cohere,local
FALLBACK_ORDER=cerebras,groq,gemini,openrouter,mistral,nvidia,huggingface,cloudflare,cohere,local
# Fail startup instead of ignoring unknown tiers in FALLBACK_ORDER.
ROUTER_STRICT_FALLBACK_ORDER=false

# Cerebras — Ultra-fast Llama inference (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=...
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_RPM=30
CEREBRAS_TPM=60000
CEREBRAS_RPD=14400

# Groq — Fast free-tier inference (https://console.groq.com)
GROQ_API_KEY=...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RPM=30
GROQ_TPM=6000
GROQ_RPD=14400

# Gemini — Google Gemini free tier (https://aistudio.google.com)
GEMINI_API_KEY=...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.7-flash
GEMINI_RPM=15
GEMINI_TPM=1000000
GEMINI_RPD=1500

# OpenRouter — Free models via one endpoint (https://openrouter.ai)
OPENROUTER_API_KEY=...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_RPM=20
OPENROUTER_TPM=40000
OPENROUTER_RPD=50

# Mistral — Mistral free tier (https://console.mistral.ai)
MISTRAL_API_KEY=...
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=codestral-latest
MISTRAL_RPM=2
MISTRAL_TPM=500000
MISTRAL_RPD=1000

# NVIDIA NIM — NVIDIA free inference (https://build.nvidia.com)
NVIDIA_API_KEY=...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_RPM=40
NVIDIA_TPM=40000
NVIDIA_RPD=1000

# Hugging Face — Inference Providers (https://huggingface.co/docs/api-inference/inference-providers)
HF_API_KEY=...
HF_PROVIDER=
# A model is required for Hugging Face to be usable.
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=
HF_RPM=20
HF_TPM=40000
HF_RPD=1000

# Cloudflare AI — Workers AI free tier (https://dash.cloudflare.com)
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_BASE_URL is derived from the credentials below; uncomment to override.
# CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/…/ai/v1
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_RPM=60
CLOUDFLARE_TPM=50000
CLOUDFLARE_RPD=10000

# Cohere — Command R+ tool-use API (https://dashboard.cohere.com)
COHERE_API_KEY=...
COHERE_BASE_URL=https://api.cohere.com/v2
COHERE_MODEL=command-r-plus-08-2024
COHERE_RPM=10
COHERE_TPM=20000
COHERE_RPD=100

# Local — Local OpenAI-compatible server (Ollama, llama.cpp, etc.)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5-coder:7b
LOCAL_RPM=120
LOCAL_TPM=100000
LOCAL_RPD=100000
