{
  "name": "model-router",
  "version": "0.1.19",
  "description": "Universal proxy with Anthropic and OpenAI APIs for 10 free-tier and local LLM providers, with automatic fallback, caching and rate limiting",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/model-router",
    "build:darwin-arm64": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/model-router-darwin-arm64",
    "build:darwin-x64": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/model-router-darwin-x64",
    "build:linux-x64": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/model-router-linux-x64",
    "build:linux-arm64": "bun build src/index.ts --compile --target=bun-linux-arm64 --outfile dist/model-router-linux-arm64",
    "build:all": "bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-x64 && bun run build:linux-arm64",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "bun test",
    "test:e2e": "RUN_E2E=true bun test tests/e2e",
    "env:generate": "bun run scripts/generate-env-example.ts",
    "env:check": "bun run scripts/generate-env-example.ts --check",
    "validate": "bun run typecheck && bun run lint && bun test && bun run env:check",
    "verify": "bun run validate && bun run build",
    "bump:version": "bun run scripts/bump-version.ts",
    "release": "sh scripts/release.sh",
    "precommit": "bun run verify",
    "prepare": "which simple-git-hooks > /dev/null 2>&1 && simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run precommit"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.4",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "anthropic",
    "openai",
    "claude",
    "claude-code",
    "codex",
    "aider",
    "cline",
    "zeroclaw",
    "llm",
    "proxy",
    "router",
    "sse",
    "cerebras",
    "groq",
    "gemini",
    "openrouter",
    "mistral",
    "nvidia",
    "huggingface",
    "cloudflare",
    "cohere",
    "ollama"
  ],
  "author": "Mitriyweb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mitriyweb/model-router.git"
  }
}
