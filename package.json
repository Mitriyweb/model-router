{
  "name": "model-router",
  "version": "0.1.7",
  "description": "Anthropic-compatible proxy for free-tier and local LLMs (Groq, Gemini Flash, OpenRouter, Ollama)",
  "main": "src/index.ts",
  "type": "module",
  "bin": {
    "model-router": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "node scripts/embed-version.js && bun build src/index.ts --compile --outfile dist/model-router",
    "build:darwin-arm64": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/model-router-darwin-arm64",
    "build:darwin-x64": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/model-router-darwin-x64",
    "build:linux-x64": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/model-router-linux-x64",
    "build:linux-arm64": "bun build src/index.ts --compile --target=bun-linux-arm64 --outfile dist/model-router-linux-arm64",
    "build:all": "bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-x64 && bun run build:linux-arm64",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "bun test",
    "validate": "bun run typecheck && bun run lint && bun test",
    "precommit": "bun run validate",
    "prepare": "which simple-git-hooks > /dev/null 2>&1 && simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run precommit"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.4",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "anthropic",
    "claude",
    "claude-code",
    "llm",
    "proxy",
    "router",
    "groq",
    "gemini",
    "openrouter",
    "ollama"
  ],
  "author": "Mitriyweb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mitriyweb/model-router.git"
  }
}
